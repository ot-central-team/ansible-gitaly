{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketAccess",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-artifacts",
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-lfs",
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-uploads",
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-packages",
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-mr-diffs",
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-terraform-state",
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-ci-secure-files"
      ]
    },
    {
      "Sid": "ObjectAccess",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-artifacts/*",
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-lfs/*",
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-uploads/*",
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-packages/*",
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-mr-diffs/*",
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-terraform-state/*",
        "arn:aws:s3:::REPLACE_BUCKET_PREFIX-ci-secure-files/*"
      ]
    }
  ]
}
