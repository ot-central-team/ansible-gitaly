# Managed by Ansible role gitaly. Edit inventory variables, not this file.

postgresql['enable'] = false
redis['enable'] = false
nginx['enable'] = false
puma['enable'] = false
sidekiq['enable'] = false
gitlab_workhorse['enable'] = false
gitlab_kas['enable'] = false
prometheus['enable'] = false
alertmanager['enable'] = false
gitlab_exporter['enable'] = false

gitlab_rails['auto_migrate'] = false
{% if gitaly_configure_gitlab_callbacks | bool %}
gitlab_rails['internal_api_url'] = {{ gitaly_internal_api_url | to_json }}
gitaly['gitlab_secret'] = {{ gitaly_gitlab_secret_token | to_json }}
{% endif %}
gitaly['enable'] = true

# Trust public HTTPS endpoints and internal peers using the combined CA bundle.
# Preserve the other default GitLab service environment settings.
gitaly['env']['SSL_CERT_FILE'] = {{ gitaly_ca_certificate_path | to_json }}

gitaly['configuration'] = {
  # Disable plaintext. Gitaly is reachable only over TLS on port 9999.
  listen_addr: nil,
  tls_listen_addr: {{ gitaly_tls_listen_address | to_json }},
  tls: {
    certificate_path: {{ gitaly_tls_certificate_path | to_json }},
    key_path: {{ gitaly_tls_privatekey_path | to_json }},
  },
  auth: {
    # Must exactly match praefect_internal_token on every Praefect VM.
    token: {{ praefect_internal_token | to_json }},
  },
  storage: [
    {
      name: {{ gitaly_storage_name | to_json }},
      path: {{ gitaly_repository_path | to_json }},
    },
  ],
}
