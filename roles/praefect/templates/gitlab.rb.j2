# Managed by Ansible role praefect. Edit inventory variables, not this file.

gitaly['enable'] = false
postgresql['enable'] = false
redis['enable'] = false
nginx['enable'] = false
puma['enable'] = false
sidekiq['enable'] = false
gitlab_workhorse['enable'] = false
gitlab_kas['enable'] = false
prometheus['enable'] = false
alertmanager['enable'] = false
gitlab_exporter['enable'] = false

gitlab_rails['auto_migrate'] = false
praefect['enable'] = true
praefect['auto_migrate'] = false

# Persist combined public and internal CA trust in the service environment.
# Keep GitLab's other default environment settings.
praefect['env']['SSL_CERT_FILE'] = {{ praefect_gitaly_ca_certificate_path | to_json }}

praefect['configuration'] = {
{% if cluster_rpc_tls_enabled | bool %}
  listen_addr: nil,
  tls_listen_addr: {{ praefect_tls_listen_address | to_json }},
  tls: {
    certificate_path: {{ praefect_tls_certificate_path | to_json }},
    key_path: {{ praefect_tls_privatekey_path | to_json }},
  },
{% else %}
  listen_addr: {{ praefect_listen_address | to_json }},
{% endif %}
  auth: {
    token: {{ praefect_external_token | to_json }},
  },
  database: {
    host: {{ hostvars[groups['bastion'][0]]['praefect_db_host'] | to_json }},
    port: {{ hostvars[groups['bastion'][0]]['praefect_db_port'] | default(praefect_database_port) | int }},
    user: {{ hostvars[groups['bastion'][0]]['praefect_db_user'] | default(praefect_database_user) | to_json }},
    password: {{ hostvars[groups['bastion'][0]]['praefect_db_password'] | to_json }},
    dbname: {{ hostvars[groups['bastion'][0]]['praefect_db_name'] | default(praefect_database_name) | to_json }},
    sslmode: {{ praefect_database_sslmode | to_json }},
    sslrootcert: {{ praefect_rds_ca_bundle_path | to_json }},
  },
  virtual_storage: [
    {
      name: {{ praefect_virtual_storage_name | to_json }},
      default_replication_factor: {{ praefect_default_replication_factor | int }},
      node: [
{% for gitaly_host in groups['gitaly'] %}
        {
          storage: {{ (hostvars[gitaly_host].gitaly_storage_name | default(gitaly_host.split('.')[0])) | to_json }},
          address: {{ (("tls://" ~ gitaly_host ~ ":" ~ (hostvars[gitaly_host].gitaly_tls_port | default(9999) | string)) if (cluster_rpc_tls_enabled | bool) else ("tcp://" ~ gitaly_host ~ ":" ~ (hostvars[gitaly_host].gitaly_plaintext_port | default(8075) | string))) | to_json }},
          token: {{ praefect_internal_token | to_json }},
        },
{% endfor %}
      ],
    },
  ],
}
